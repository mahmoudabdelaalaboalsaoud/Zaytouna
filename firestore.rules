rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function isAdmin() { return signed() && request.auth.token.admin == true; }
    function me(uid) { return signed() && request.auth.uid == uid; }
    // التاجر يضيف منتجات فقط وهو في التجربة أو اشتراكه نشط وغير منتهٍ
    function subOk() {
      let m = get(/databases/$(db)/documents/merchants/$(request.auth.uid)).data;
      return m.status in ['trial', 'active'] && m.endsAt > request.time;
    }

    match /merchants/{uid} {
      allow read: if me(uid) || isAdmin();
      // التسجيل يبدأ دائماً بتجربة 3 شهور؛ التفعيل والباقة من الإدارة فقط
      allow create: if me(uid) && request.resource.data.status == 'trial'
        && request.resource.data.endsAt <= request.time + duration.value(91, 'd');
      allow update: if isAdmin() || (me(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'city', 'about']));
    }
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin() || me(resource.data.merchantId);
      allow create: if me(request.resource.data.merchantId) && subOk();
      allow update, delete: if isAdmin() || (me(resource.data.merchantId) && subOk()
        && request.resource.data.merchantId == resource.data.merchantId);
    }
    match /orders/{id} {
      allow create: if signed() && request.resource.data.buyerId == request.auth.uid && request.resource.data.status == 'new';
      allow read: if signed() && (resource.data.buyerId == request.auth.uid || resource.data.merchantId == request.auth.uid || isAdmin());
      allow update: if signed() && (resource.data.merchantId == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
