rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function verified() { return signed() && request.auth.token.email_verified == true; }
    function isOwner() { return verified() && request.auth.token.email == 'mahmoudabdelaalaboalsaoud@gmail.com'; }
    function isAdmin() {
      return isOwner()
        || (verified() && exists(/databases/$(db)/documents/admins/$(request.auth.token.email)))
        || (signed() && request.auth.token.admin == true);
    }
    function me(uid) { return signed() && request.auth.uid == uid; }
    function mer() { return get(/databases/$(db)/documents/merchants/$(request.auth.uid)).data; }
    function subOk() {
      let m = mer();
      return m.status in ['trial', 'active'] && m.endsAt > request.time;
    }

    // شكل المنتج وحدود القيم، واسم التاجر ورقمه يطابقان بياناته
    function prodOk(d) {
      let m = mer();
      return d.keys().hasOnly(['merchantId', 'merchantName', 'merchantPhone', 'name', 'origin', 'acidity', 'liters', 'price', 'wholesale', 'tags', 'active', 'image', 'createdAt'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 80
        && d.origin is string && d.origin.size() <= 60
        && d.acidity is number && d.acidity >= 0 && d.acidity <= 5
        && d.liters is number && d.liters > 0 && d.liters <= 1000
        && d.price is number && d.price > 0 && d.price <= 1000000
        && d.wholesale is bool && d.active is bool
        && d.tags is list && d.tags.size() <= 3
        && (!('image' in d) || (d.image is string
            && d.image.matches('^https://ptimioffmszhmpxxuqha[.]supabase[.]co/storage/v1/object/public/zaytouna-products/' + d.merchantId + '/.+')))
        && d.merchantName == m.name && d.merchantPhone == m.phone;
    }
    // سطر الطلب: الاسم والسعر واللترات تؤخذ من المنتج نفسه في قاعدة البيانات
    function lineOk(l, mid) {
      let p = get(/databases/$(db)/documents/products/$(l.id)).data;
      return l.keys().hasOnly(['id', 'name', 'price', 'liters', 'q'])
        && l.q is int && l.q >= 1 && l.q <= 50
        && p.active == true && p.merchantId == mid
        && l.name == p.name && l.price == p.price && l.liters == p.liters;
    }
    // التقييم بالنجوم: لمن اشترى المنتج وأكّد التاجر طلبه (حالة مكتمل)
    function boughtOk(oid, pid, uid) {
      let o = get(/databases/$(db)/documents/orders/$(oid)).data;
      return o.buyerId == uid && o.status == 'done'
        && ((o.items.size() > 0 && o.items[0].id == pid)
         || (o.items.size() > 1 && o.items[1].id == pid)
         || (o.items.size() > 2 && o.items[2].id == pid)
         || (o.items.size() > 3 && o.items[3].id == pid)
         || (o.items.size() > 4 && o.items[4].id == pid));
    }
    function revOk(d, pid, uid) {
      return d.keys().hasOnly(['uid', 'name', 'text', 'rating', 'verified', 'orderId', 'createdAt'])
        && d.uid == uid
        && d.name is string && d.name.size() <= 60
        && d.text is string && d.text.size() <= 500
        && d.rating is int && d.rating >= 0 && d.rating <= 5
        && d.verified is bool && d.createdAt is timestamp
        && (d.text.size() > 0 || d.rating > 0)
        && ((d.rating == 0 && d.verified == false)
            || (d.rating > 0 && d.verified == true && d.orderId is string
                && get(/databases/$(db)/documents/products/$(pid)).data.merchantId != uid
                && boughtOk(d.orderId, pid, uid)));
    }
    function lt(it, i) { return it.size() > i ? it[i].price * it[i].q : 0; }
    function orderOk(d) {
      let it = d.items;
      return d.keys().hasOnly(['buyerId', 'buyerName', 'buyerPhone', 'merchantId', 'merchantName', 'merchantPhone', 'items', 'total', 'status', 'createdAt'])
        && d.buyerId == request.auth.uid && d.status == 'new'
        && d.createdAt == request.time
        && d.buyerName is string && d.buyerName.size() <= 60
        && d.buyerPhone is string && d.buyerPhone.matches('^01[0125][0-9]{8}$')
        && d.merchantId is string
        && d.merchantName is string && d.merchantName.size() <= 80
        && d.merchantPhone is string && d.merchantPhone.size() <= 20
        && it is list && it.size() >= 1 && it.size() <= 5
        && lineOk(it[0], d.merchantId)
        && (it.size() < 2 || lineOk(it[1], d.merchantId))
        && (it.size() < 3 || lineOk(it[2], d.merchantId))
        && (it.size() < 4 || lineOk(it[3], d.merchantId))
        && (it.size() < 5 || lineOk(it[4], d.merchantId))
        && d.total == lt(it, 0) + lt(it, 1) + lt(it, 2) + lt(it, 3) + lt(it, 4);
    }

    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    match /merchants/{uid} {
      allow read: if me(uid) || isAdmin();
      allow create: if me(uid)
        && request.resource.data.keys().hasOnly(['name', 'phone', 'city', 'about', 'status', 'endsAt', 'createdAt'])
        && request.resource.data.status == 'trial'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 60
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 20
        && request.resource.data.city is string && request.resource.data.city.size() <= 80
        && request.resource.data.endsAt is timestamp
        && request.resource.data.endsAt <= request.time + duration.value(91, 'd');
      allow update: if isAdmin() || (me(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'city', 'about']));
      allow delete: if isAdmin();
    }
    match /products/{id} {
      allow read: if resource.data.active == true || isAdmin() || me(resource.data.merchantId);
      allow create: if me(request.resource.data.merchantId) && subOk() && prodOk(request.resource.data);
      allow update: if isAdmin() || (me(resource.data.merchantId) && subOk()
        && request.resource.data.merchantId == resource.data.merchantId && prodOk(request.resource.data));
      allow delete: if isAdmin() || (me(resource.data.merchantId) && subOk());
    }
    match /orders/{id} {
      allow create: if signed() && orderOk(request.resource.data);
      allow read: if signed() && (resource.data.buyerId == request.auth.uid || resource.data.merchantId == request.auth.uid || isAdmin());
      allow update: if signed() && (resource.data.merchantId == request.auth.uid || isAdmin())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'accepted', 'done', 'cancelled'];
      allow delete: if isAdmin();
    }
    // صفحة المتجر العامة: نسخة من بيانات التاجر الظاهرة للزوار
    match /stores/{uid} {
      allow read: if true;
      allow create, update: if me(uid) && subOk()
        && request.resource.data.keys().hasOnly(['name', 'phone', 'city', 'about'])
        && request.resource.data.name == mer().name
        && request.resource.data.phone == mer().phone
        && request.resource.data.city == mer().city
        && request.resource.data.about == mer().about
        && request.resource.data.about.size() <= 300;
      allow delete: if isAdmin();
    }
    // تعليقات وتقييمات المنتج: القراءة للجميع، والكتابة للأعضاء المسجلين فقط
    match /products/{pid}/reviews/{uid} {
      allow read: if true;
      allow create: if me(uid) && revOk(request.resource.data, pid, uid) && request.resource.data.createdAt == request.time;
      allow update: if me(uid) && revOk(request.resource.data, pid, uid) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if me(uid) || isAdmin();
    }
    match /{path=**}/reviews/{id} {
      allow read: if true;
    }
  }
}
